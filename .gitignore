# ===== Python / uv =====
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
.venv/
venv/
env/
ENV/
.python-version
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
htmlcov/
.coverage
.coverage.*

# ===== uv 锁文件保留，但忽略本地缓存 =====
# uv.lock 需要提交以保证依赖一致
# backend/uv.lock  ← 不要忽略

# ===== Node / 前端 =====
node_modules/
dist/
build/
.vite/
*.tsbuildinfo
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ===== 环境变量与密钥（禁止入库）=====
.env
.env.local
.env.*.local
*.pem
*.key

# ===== SQLite 数据库文件 =====
storage/db/*.db
storage/db/*.db-journal
storage/db/*.db-wal
storage/db/*.db-shm
*.sqlite
*.sqlite3

# ===== 后端运行时数据（config 默认 storage_root 相对 backend 目录）=====
backend/storage/

# ===== 下载的视频缓存 / 提取的音频缓存 =====
storage/videos/*
!storage/videos/.gitkeep
storage/audios/*
!storage/audios/.gitkeep
storage/exports/*
!storage/exports/.gitkeep

# ===== 日志 =====
storage/logs/*
!storage/logs/.gitkeep
*.log

# ===== IDE / 编辑器 =====
.idea/
.vscode/
*.swp
*.swo
.DS_Store
Thumbs.db

# ===== AI 工具配置（不入库）=====
.codeartsdoer/
.claude/

# ===== Playwright 产物 =====
captcha.png
playwright-report/
test-results/
blob-report/
playwright/.cache/

# ===== Docker 运行产物 =====
docker-data/

# ===== 临时文件 =====
tmp/
temp/
*.tmp

# pip 在 TEMP 目录不可写时会在当前目录创建解包临时目录（%TEMP% 权限异常时）
pip-unpack-*/
*.whl
# ===== 调试 / 临时搜索脚本 =====
_search*.py
_search*.txt
_search_result.txt
nohup.out
