# ============================================================
# 交大课录智析 · 环境变量模板
# 复制为 .env 并填入真实值，.env 已被 .gitignore 排除，禁止入库
# 详细说明见 docs/06-env-vars.md
# ============================================================

# ---------- 应用基础 ----------
APP_ENV=dev                          # dev / prod
APP_NAME=BJTU-lecture-analy
APP_HOST=0.0.0.0
APP_PORT=8000
APP_LOG_LEVEL=INFO                   # DEBUG / INFO / WARNING / ERROR

# ---------- 数据库（SQLite）----------
# 数据库文件存放于 storage/db/，由 .gitignore 排除
DATABASE_URL=sqlite:///./storage/db/app.db

# ---------- 安全 / 鉴权 ----------
# 留空则每次启动随机生成（后端重启后所有已签发 JWT 自动失效，强制重新登录）
# 如需跨重启保持登录，请手动生成固定值：python -c "import secrets;print(secrets.token_urlsafe(32))"
# SECRET_KEY=change-me-to-a-strong-random-secret
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=480   # 8 小时

# 跨域：前端开发服务器地址
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---------- 本地存储根目录 ----------
STORAGE_ROOT=./storage
VIDEO_CACHE_DIR=./storage/videos
AUDIO_CACHE_DIR=./storage/audios
LOG_DIR=./storage/logs
EXPORT_DIR=./storage/exports

# 音频/视频缓存自动清理：保留天数，超过则清理
CACHE_RETENTION_DAYS=7
# 解析任务完成后是否立即删除中间音频文件
CLEANUP_AUDIO_AFTER_TASK=true

# ---------- 硅基流动 API（ASR + LLM 共用凭证）----------
SILICONFLOW_API_KEY=your_siliconflow_api_key
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ASR 语音转写（句级时间戳）
SILICONFLOW_ASR_MODEL=XingChenAGI/XingChenASR-V3.2-Ultra
# 单个音频分片的请求超时（秒）
SILICONFLOW_ASR_TIMEOUT=300
# ASR 失败最大重试次数
SILICONFLOW_ASR_MAX_RETRY=3
# 长回放切片：单分片最长时长（秒）与最大体积（MB）
SILICONFLOW_ASR_CHUNK_SECONDS=480
SILICONFLOW_ASR_CHUNK_MAX_MB=20
# 并行转写分片数（并发上传 API）
SILICONFLOW_ASR_WORKERS=4
# 接口不返回时间戳时，是否退回按字数估算时间轴（true=可用但精度下降）
SILICONFLOW_ASR_ALLOW_ESTIMATED_TIMESTAMPS=true

# 大模型语义解析（重点 / 分层总结 / 两级思维导图）
SILICONFLOW_MODEL=Qwen/Qwen3-8B
SILICONFLOW_TIMEOUT=180
SILICONFLOW_MAX_RETRY=3
# 单次投喂的最大转写字符数，超出后按时间窗口分段
SILICONFLOW_MAX_INPUT_CHARS=12000

# ---------- 课程平台对接（北交大）----------
# 课程平台根（详见 docs/10-platform-feasibility-analysis.md）
PLATFORM_BASE_URL=http://123.121.147.7:88/ve
PLATFORM_VIDEO_FORMATS=mp4,flv,hls
PLATFORM_REQUEST_TIMEOUT=60
# CAS 统一身份认证（Playwright 无头浏览器登录，cookie 导出给 httpx 复用）
PLATFORM_CAS_LOGIN_URL=https://mis.bjtu.edu.cn
# CAS 用户名/密码不在此配置，由用户打开网页后在前端登录页手动输入
# userId 和 cId 在登录后自动获取，无需手动配置：
#   - userId: cas_login() 从登录后页面自动提取
#   - cId:    list_user_courses() 从课程平台首页自动解析
# 后台自动登录回退凭证（可选）：pipeline 无前端交互时使用；前台登录优先走 API 透传
# 留空则必须由前端登录页手动输入
PLATFORM_USERNAME=
PLATFORM_PASSWORD=
# CAS 验证码处理方式：ocr / manual（manual=前端弹出让学生手动输入，最可靠）
PLATFORM_CAPTCHA_MODE=manual
# CAS Cookie 有效期（秒），过期前需完成下载
PLATFORM_COOKIE_TTL=28800

# ---------- 解析任务调度 ----------
# 单任务整体超时（秒），60-120min 视频建议 ≥ 3600
TASK_TOTAL_TIMEOUT=3600
# BackgroundTasks 并发上限（MVP 不引入消息队列）
TASK_MAX_CONCURRENT=2
# 重点时间点跳转最大允许偏差（秒），NFR-02 要求 ≤ 2
TIMESTAMP_TOLERANCE_SEC=2
# 平台 VTT 字幕覆盖时长占比达到该阈值时直接复用，不再调用 ASR
VTT_MIN_COVERAGE=0.5

# ---------- 可选：阿里云 OSS 备选存储 ----------
# 留空则使用本地磁盘；填写后二进制资源上传 OSS
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_ENDPOINT=
OSS_BUCKET_NAME=
OSS_ENABLED=false